{
  "info": {
    "title": "Echo API",
    "version": "1.0.0",
    "description": "A simple echo endpoint used for testing and demonstration purposes.\nReturns the full request details including headers, query parameters, and body.\nHosted at echo.zuplo.io — commonly used as a mock backend in Zuplo gateway demos.\n"
  },
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "EchoResponse": {
        "type": "object",
        "description": "Full echo of the incoming request",
        "properties": {
          "method": {
            "type": "string",
            "description": "HTTP method of the request",
            "example": "GET"
          },
          "url": {
            "type": "string",
            "description": "Full URL of the request",
            "example": "https://echo.zuplo.io/path-10"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "All request headers as key-value pairs",
            "example": {
              "authorization": "Bearer zpka_abc123",
              "content-type": "application/json"
            }
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Query string parameters as key-value pairs",
            "example": {
              "foo": "bar"
            }
          },
          "body": {
            "description": "Request body — null for GET requests",
            "nullable": true,
            "type": "null"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer token — your Zuplo API key"
      }
    }
  },
  "servers": [
    {
      "url": "https://echo.zuplo.io",
      "description": "Zuplo echo service"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/mcp-a/linear": {
      "get,post": {
        "operationId": "linear-gateway-a",
        "summary": "Linear MCP (Gateway A: gateway-issued OAuth with DCR)",
        "description": "MCP clients register and sign in through the gateway's own OAuth authorization server (DCR and CIMD), which delegates browser login to Entra ID. Linear tools are limited per app by the OAuth client ID: CIMD clients by their metadata URL, all DCR clients by a shared 'dcr:*' profile. Each user connects their own Linear account once; the gateway stores and refreshes that token.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "module": "$import(@zuplo/runtime/mcp-gateway)",
            "export": "McpProxyHandler",
            "options": {
              "rewritePattern": "https://mcp.linear.app/mcp"
            }
          },
          "policies": {
            "inbound": [
              "gateway-a-entra-oauth",
              "gateway-a-tool-audit",
              "gateway-a-user-role-filter",
              "gateway-a-client-tool-filter",
              "linear-token-exchange"
            ],
            "outbound": [
              "gateway-a-sse-to-json"
            ]
          }
        }
      }
    },
    "/mcp-b/linear": {
      "get,post": {
        "operationId": "linear-gateway-b",
        "summary": "Linear MCP (Gateway B: Entra access tokens, no DCR)",
        "description": "Clients send an Entra ID access token issued for the gateway's API. The gateway validates it directly (no gateway-issued tokens, no DCR), limits Linear tools by the token's azp claim (the calling app), and uses the user's own stored Linear token upstream.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "module": "$import(@zuplo/runtime/mcp-gateway)",
            "export": "McpProxyHandler",
            "options": {
              "rewritePattern": "https://mcp.linear.app/mcp"
            }
          },
          "policies": {
            "inbound": [
              "gateway-b-entra-jwt",
              "gateway-b-tool-audit",
              "gateway-b-connect-fallback",
              "gateway-b-azp-tool-filter",
              "linear-token-exchange"
            ],
            "outbound": [
              "gateway-b-sse-to-json"
            ]
          }
        }
      }
    },
    "/path-11": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Echo a GET request",
        "description": "Returns the full details of the incoming GET request as JSON — headers, query parameters, URL, and method.",
        "operationId": "echo-get",
        "parameters": [
          {
            "name": "any",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Any query parameters are echoed back in the response"
          }
        ],
        "responses": {
          "200": {
            "description": "Echo response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                },
                "example": {
                  "method": "GET",
                  "url": "https://echo.zuplo.io/path-10?foo=bar",
                  "headers": {
                    "authorization": "Bearer zpka_abc123",
                    "user-agent": "curl/7.88.1",
                    "accept": "*/*"
                  },
                  "query": {
                    "foo": "bar"
                  },
                  "body": null
                }
              }
            }
          }
        }
      }
    }
  }
}